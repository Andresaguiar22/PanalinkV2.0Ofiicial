<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never restore private/account-bound local data into another installation/account. -->
        <exclude domain="database" path="panalink_database" />
        <exclude domain="sharedpref" path="panalink_session_secure_prefs.xml" />
        <exclude domain="sharedpref" path="panalink_session_prefs.xml" />
        <exclude domain="sharedpref" path="panalink_cache_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Room contains private chats/messages/states and must never cross accounts/devices. -->
        <exclude domain="database" path="panalink_database" />
        <exclude domain="sharedpref" path="panalink_session_secure_prefs.xml" />
        <exclude domain="sharedpref" path="panalink_session_prefs.xml" />
        <exclude domain="sharedpref" path="panalink_cache_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
